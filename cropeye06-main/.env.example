# Local dev now uses direct Railway production URLs by default (visible in Network tab).
# Restart dev server after changing this file: npm run dev
#
# To go back to localhost proxy (/api/* on :3001), uncomment:
# VITE_USE_API_PROXY=true
#
# Or override individual services:
# VITE_GRAPES_EVENTS_BASE_URL=https://cropeye-grapes-events-production.up.railway.app
# VITE_GRAPES_MAIN_BASE_URL=https://cropeye-grapes-main-production.up.railway.app
# VITE_GRAPES_ADMIN_BASE_URL=https://cropeye-grapes-admin-production.up.railway.app
# VITE_GRAPES_SEF_BASE_URL=https://cropeye-grapes-sef-production.up.railway.app
# VITE_API_BASE_URL=https://cropeye-backendd.up.railway.app/api
# VITE_WEATHER_API_BASE_URL=https://weather-cropeye.up.railway.app
# VITE_FORECAST_WEATHER_API_BASE_URL=https://currentforecast-production.up.railway.app
